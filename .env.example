# Flask Configuration
FLASK_APP=app.py
FLASK_ENV=development
SECRET_KEY=your-secret-key-here-change-in-production

# Database
DATABASE_URL=sqlite:///ats_analyzer.db

# File Upload
UPLOAD_FOLDER=uploads
MAX_FILE_SIZE=16777216

# ATS Settings
SCORE_THRESHOLD=60
MIN_KEYWORD_LENGTH=2

# Server
DEBUG=True
HOST=0.0.0.0
PORT=5000
